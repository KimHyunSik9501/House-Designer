<Window x:Class="HouseDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HouseDesigner.Controls"
        Title="House Designer" Width="1480" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#FFF3F3F1"
        FontFamily="Segoe UI" Foreground="#FF242423">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding LoadCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="64" Background="White"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="#FF20201F" Margin="0,0,11,0">
                        <TextBlock Text="H" Foreground="White" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="HOUSE DESIGNER" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="RESIDENTIAL FLOOR PLAN" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                    <Border Background="#FFF1F1EF" CornerRadius="12" Margin="24,0,0,0" Padding="11,5">
                        <TextBlock Text="{Binding ActiveToolName}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DocumentTitle}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="열기" Command="{Binding LoadCommand}" ToolTip="JSON 도면 열기 (Ctrl+O)" />
                    <Button Content="저장" Command="{Binding SaveCommand}" ToolTip="JSON 저장 (Ctrl+S)" />
                    <Button Content="다른 이름" Command="{Binding SaveAsCommand}" />
                    <Button Content="CSV" Command="{Binding ExportCsvCommand}" ToolTip="요소 데이터를 CSV로 내보내기" />
                    <Button Content="SVG" Command="{Binding ExportSvgCommand}" ToolTip="도면 경계에 맞춰 SVG로 내보내기" />
                    <CheckBox Content="스냅" IsChecked="{Binding IsGridSnapEnabled}"
                              VerticalAlignment="Center" Margin="10,0" />
                    <Button Content="전체 초기화" Command="{Binding ClearCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="292" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFAFAF9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,20">
                        <TextBlock Text="EDIT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="8,0,0,8" />
                        <Button Style="{StaticResource ToolButtonStyle}" Content="↖   선택 및 이동" Command="{Binding SelectToolCommand}" CommandParameter="Select" />

                        <TextBlock Text="ARCHITECTURE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="8,20,0,8" />
                        <Button Style="{StaticResource ToolButtonStyle}" Content="▧   방 영역 · 면적" Command="{Binding SelectToolCommand}" CommandParameter="RoomArea" />
                        <Button Style="{StaticResource ToolButtonStyle}" Content="╱   벽" Command="{Binding SelectToolCommand}" CommandParameter="Wall" />
                        <Button Style="{StaticResource ToolButtonStyle}" Content="◿   문" Command="{Binding SelectToolCommand}" CommandParameter="Door" />
                        <Button Style="{StaticResource ToolButtonStyle}" Content="═   창문" Command="{Binding SelectToolCommand}" CommandParameter="Window" />
                        <Button Style="{StaticResource ToolButtonStyle}" Content="↔   치수선" Command="{Binding SelectToolCommand}" CommandParameter="Dimension" />
                        <Button Style="{StaticResource ToolButtonStyle}" Content="▤   계단" Command="{Binding PlaceStairsCommand}" />
                        <Button Style="{StaticResource ToolButtonStyle}" Content="T   텍스트 / 방 이름" Command="{Binding SelectToolCommand}" CommandParameter="RoomLabel" />
                        <Button Style="{StaticResource ToolButtonStyle}" Content="━   도로" Command="{Binding PlaceSiteElementCommand}" CommandParameter="Road" />
                        <Button Style="{StaticResource ToolButtonStyle}" Content="♣   나무" Command="{Binding PlaceSiteElementCommand}" CommandParameter="Tree" />
                        <Button Style="{StaticResource ToolButtonStyle}" Content="▰   벤치" Command="{Binding PlaceSiteElementCommand}" CommandParameter="Bench" />

                        <TextBlock Text="FURNITURE &amp; FIXTURES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="8,20,0,8" />
                        <ComboBox ItemsSource="{Binding FurnitureChoices}"
                                  DisplayMemberPath="Name" SelectedValuePath="Kind"
                                  SelectedValue="{Binding SelectedFurnitureKind}" Margin="3,0,3,7" />
                        <Button Style="{StaticResource ToolButtonStyle}" Content="＋   선택한 요소 배치" Command="{Binding SelectToolCommand}" CommandParameter="Furniture" />

                        <Border Background="#FFF1F1EF" CornerRadius="8" Margin="3,24,3,0" Padding="12">
                            <StackPanel>
                                <TextBlock Text="빠른 사용법" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,7" />
                                <TextBlock Text="두 점 또는 두 모서리를 차례로 클릭해 구조를 만듭니다. 선택 후 드래그로 이동하고 핸들로 크기를 조절하세요."
                                           TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="11" LineHeight="17" />
                                <TextBlock Text="우클릭 드래그  화면 이동&#x0a;마우스 휠  확대·축소&#x0a;Delete  요소 삭제"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" LineHeight="18" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Margin="14">
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <controls:FloorPlanCanvas FloorPlan="{Binding FloorPlan}"
                                              ActiveTool="{Binding ActiveTool}"
                                              IsGridSnapEnabled="{Binding IsGridSnapEnabled}"
                                              GridSize="{Binding GridSize}"
                                              SelectedElement="{Binding SelectedElement, Mode=TwoWay}"
                                              SelectedFurnitureKind="{Binding SelectedFurnitureKind}"
                                              SelectedSiteElementKind="{Binding SelectedSiteElementKind}" />
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="#FFFAFAF9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,20">
                        <TextBlock Text="PROPERTIES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />

                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,10,0,14">
                            <StackPanel>
                                <TextBlock Text="도면 요약" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ElementSummary}" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="78" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="그리드 (cm)" VerticalAlignment="Center" FontSize="12" />
                                    <TextBox Grid.Column="1" Text="{Binding GridSize, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="SELECTION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedElementName}" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedElementDetails}" TextWrapping="Wrap" LineHeight="21" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="↶  왼쪽 90°" Command="{Binding RotateLeftCommand}" Margin="0,0,3,0" />
                                    <Button Grid.Column="1" Content="↷  오른쪽 90°" Command="{Binding RotateRightCommand}" Margin="3,0,0,0" />
                                </Grid>

                                <TextBlock Text="정확한 크기" FontWeight="SemiBold" FontSize="12" Margin="0,18,0,7" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="82" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="길이 (cm)" VerticalAlignment="Center" FontSize="12" />
                                    <TextBox Grid.Column="1" Text="{Binding SelectedLength, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanEditLength}" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Text="너비 (cm)" VerticalAlignment="Center" FontSize="12" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedWidth, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanEditWidth}" Margin="0,3" />
                                    <TextBlock Grid.Row="2" Text="높이 (cm)" VerticalAlignment="Center" FontSize="12" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedHeight, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanEditHeight}" Margin="0,3" />
                                    <TextBlock Grid.Row="3" Text="벽 두께 (cm)" VerticalAlignment="Center" FontSize="12" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedThickness, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanEditThickness}" Margin="0,3" />
                                    <TextBlock Grid.Row="4" Text="글자 크기" VerticalAlignment="Center" FontSize="12" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedFontSize, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanEditFontSize}" Margin="0,3" />
                                </Grid>

                                <TextBlock Text="이름" FontWeight="SemiBold" FontSize="12" Margin="0,16,0,6" />
                                <TextBox Text="{Binding SelectedRoomName, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanEditRoomName}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="82" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Level (층)" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding SelectedRoomLevel, UpdateSourceTrigger=LostFocus}"
                                             IsEnabled="{Binding CanEditRoomLevel}" />
                                </Grid>
                                <Button Content="선택 요소 삭제" Command="{Binding DeleteSelectedCommand}" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="TOTAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,20,0,0" />
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,10,0,20">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total Level Area" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding TotalRoomAreaText}" FontWeight="SemiBold" FontSize="12" TextAlignment="Right" />
                                </Grid>
                                <Separator Margin="0,11" />
                                <ItemsControl ItemsSource="{Binding LevelAreaSummaries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="{Binding AreaText}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
